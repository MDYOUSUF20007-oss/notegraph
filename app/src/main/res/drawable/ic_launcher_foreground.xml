    <!-- Rainbow Gradient 'N' Stroke -->
    <path
        android:strokeWidth="4.5"
        android:strokeColor="#00FFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M28,68 L28,40 L44,68 L44,40">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="28"
                android:startY="40"
                android:endX="44"
                android:endY="68">
                <item android:color="#00FFFF" android:offset="0.0"/>
                <item android:color="#8B5CF6" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Rainbow Gradient 'G' Stroke -->
    <path
        android:strokeWidth="4.5"
        android:strokeColor="#8B5CF6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M78,46 C74,40 64,38 56,44 C48,50 48,60 56,66 C64,70 76,68 76,56 L64,56">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="48"
                android:startY="40"
                android:endX="78"
                android:endY="70">
                <item android:color="#8B5CF6" android:offset="0.0"/>
                <item android:color="#EC4899" android:offset="0.6"/>
                <item android:color="#F59E0B" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Minimalist Fountain Pen Nib intersecting the Monogram -->
    <!-- Pen Nib Body -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,20 L62,34 L58,52 L50,52 L46,34 Z"/>

    <!-- Pen Nib Slit & Breather Hole -->
    <path
        android:strokeWidth="1.2"
        android:strokeColor="#8B5CF6"
        android:strokeLineCap="round"
        android:pathData="M54,20 L54,38"/>
    <path
        android:fillColor="#8B5CF6"
        android:pathData="M54,39m-1.8,0a1.8,1.8 0,1 1,3.6 0a1.8,1.8 0,1 1,-3.6 0"/>

    <!-- Pen Nib Tip Sparkle / Accent (Cyan to Violet) -->
    <path
        android:fillColor="#00FFFF"
        android:pathData="M54,16 L55.2,18.8 L58,20 L55.2,21.2 L54,24 L52.8,21.2 L50,20 L52.8,18.8 Z"/>

    <!-- Bottom Rainbow Accent Bar -->
    <path
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M34,78 L74,78">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="34"
                android:startY="78"
                android:endX="74"
                android:endY="78">
                <item android:color="#00FFFF" android:offset="0.0"/>
                <item android:color="#8B5CF6" android:offset="0.33"/>
                <item android:color="#EC4899" android:offset="0.66"/>
                <item android:color="#F59E0B" android:offset="1.0"/>
